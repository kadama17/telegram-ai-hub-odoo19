<odoo>
  <record id="module_category_messaging" model="ir.module.category">
    <field name="name">Messaging Automation</field>
    <field name="sequence">30</field>
  </record>
  <record id="group_messaging_reader" model="res.groups">
    <field name="name">Report Reader</field>
  </record>
  <record id="group_messaging_operator" model="res.groups">
    <field name="name">Operator</field>
    <field name="implied_ids" eval="[(4, ref('group_messaging_reader'))]"/>
  </record>
  <record id="group_messaging_designer" model="res.groups">
    <field name="name">Automation Designer</field>
    <field name="implied_ids" eval="[(4, ref('group_messaging_operator'))]"/>
  </record>
  <record id="group_messaging_technical" model="res.groups">
    <field name="name">Technical Administrator</field>
    <field name="implied_ids" eval="[(4, ref('group_messaging_designer'))]"/>
  </record>
  <record id="group_messaging_manager" model="res.groups">
    <field name="name">Messaging Administrator</field>
    <field name="implied_ids" eval="[(4, ref('group_messaging_technical'))]"/>
  </record>
  <record id="rule_conversation_company" model="ir.rule">
    <field name="name">Messaging conversations by company</field>
    <field name="model_id" ref="model_rb_messaging_conversation"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('group_messaging_operator'))]"/>
  </record>
  <record id="rule_message_company" model="ir.rule">
    <field name="name">Messaging messages by company</field>
    <field name="model_id" ref="model_rb_messaging_message"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('group_messaging_operator'))]"/>
  </record>
</odoo>
