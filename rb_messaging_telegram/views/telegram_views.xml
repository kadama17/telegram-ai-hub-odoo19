<odoo>
  <record id="view_connection_telegram_form" model="ir.ui.view">
    <field name="name">rb.messaging.connection.telegram.form</field>
    <field name="model">rb.messaging.connection</field>
    <field name="inherit_id" ref="rb_messaging_automation_core.view_connection_form"/>
    <field name="arch" type="xml">
      <field name="webhook_url" position="after">
        <group string="Telegram Bot API">
          <field name="bot_token" password="True"/><field name="bot_username"/>
          <field name="telegram_webhook_secret" password="True"/>
          <field name="allow_private"/><field name="allow_groups"/><field name="allow_channels"/>
          <button name="action_test_telegram" type="object" string="Test connection"/>
          <button name="action_install_telegram_webhook" type="object" string="Install webhook"/>
        </group>
      </field>
    </field>
  </record>
  <record id="view_telegram_user_list" model="ir.ui.view">
    <field name="name">rb.messaging.telegram.user.list</field>
    <field name="model">rb.messaging.telegram.user</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/><field name="telegram_id"/><field name="telegram_username"/>
        <field name="odoo_user_id"/><field name="company_id"/><field name="active"/>
      </list>
    </field>
  </record>
  <record id="view_telegram_user_form" model="ir.ui.view">
    <field name="name">rb.messaging.telegram.user.form</field>
    <field name="model">rb.messaging.telegram.user</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group string="Telegram identity">
            <field name="name"/>
            <field name="telegram_id"/>
            <field name="telegram_username"/>
            <field name="odoo_user_id"/>
            <field name="company_id"/>
            <field name="active"/>
          </group>
          <group string="Business permissions">
            <field name="permission_contacts"/>
            <field name="permission_crm"/>
            <field name="permission_sales_read"/>
            <field name="permission_invoices_read"/>
            <field name="permission_invoices_create"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_telegram_users" model="ir.actions.act_window">
    <field name="name">Authorized Telegram Users</field>
    <field name="res_model">rb.messaging.telegram.user</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_telegram_users"
            name="Telegram Users"
            parent="rb_messaging_automation_core.menu_configuration"
            action="action_telegram_users"
            sequence="20"/>

  <record id="view_telegram_hub_dashboard_form" model="ir.ui.view">
    <field name="name">rb.telegram.hub.dashboard.form</field>
    <field name="model">rb.telegram.hub.dashboard</field>
    <field name="arch" type="xml">
      <form create="0" edit="0" delete="0">
        <header>
          <button name="action_refresh" type="object" string="Refresh" class="btn-primary"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>Telegram statistics</h1>
            <p>Activity and performance indicators for your Telegram assistants</p>
          </div>
          <group string="Usage" col="4">
            <field name="active_bot_count"/>
            <field name="authorized_user_count"/>
            <field name="conversation_count"/>
            <field name="automated_count"/>
            <field name="human_count"/>
          </group>
          <group string="Messages" col="4">
            <field name="incoming_today"/>
            <field name="outgoing_today"/>
            <field name="messages_7d"/>
            <field name="messages_30d"/>
          </group>
          <group string="Processing performance" col="4">
            <field name="processed_event_count"/>
            <field name="failed_event_count"/>
            <field name="success_rate"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_open_telegram_dashboard" model="ir.actions.server">
    <field name="name">Telegram AI Hub</field>
    <field name="model_id" ref="model_rb_telegram_hub_dashboard"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_dashboard()</field>
  </record>
  <record id="action_telegram_dashboard_client" model="ir.actions.client">
    <field name="name">Telegram Dashboard</field>
    <field name="tag">rb_telegram_dashboard</field>
  </record>

  <record id="view_telegram_onboarding_form" model="ir.ui.view">
    <field name="name">rb.telegram.onboarding.wizard.form</field>
    <field name="model">rb.telegram.onboarding.wizard</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="step" widget="statusbar" statusbar_visible="welcome,botfather,token,ai,admin,done"/>
        </header>
        <sheet>
          <div invisible="step != 'welcome'">
            <h2>Welcome to Telegram AI Hub</h2>
            <p>This assistant will create the Odoo connection, verify the Telegram bot, install the webhook, configure AI and authorize the first administrator.</p>
            <p>You can leave the wizard at any time and use the manual configuration screens.</p>
            <button name="action_open_manual" type="object" string="Use manual configuration" class="btn-secondary"/>
          </div>

          <div invisible="step != 'botfather'">
            <h2>1. Create your bot with BotFather</h2>
            <ol>
              <li>Open BotFather using the button below.</li>
              <li>Send <code>/newbot</code>.</li>
              <li>Choose the public bot name.</li>
              <li>Choose a username ending with <code>bot</code>.</li>
              <li>Copy the HTTP API token supplied by BotFather.</li>
            </ol>
            <button name="action_open_botfather" type="object" string="Open BotFather" class="btn-primary"/>
          </div>

          <div invisible="step != 'token'">
            <h2>2. Connect Telegram to Odoo</h2>
            <group>
              <field name="company_id"/>
              <field name="connection_name"/>
              <field name="bot_token" password="True" placeholder="123456789:AA..."/>
              <field name="bot_username"/>
            </group>
            <button name="action_test_token" type="object" string="Verify token and continue" class="btn-primary"/>
          </div>

          <div invisible="step != 'ai'">
            <h2>3. Configure the AI assistant</h2>
            <p>The key is stored only in Odoo and is never added to the module source code.</p>
            <group>
              <field name="ai_api_key" password="True"/>
              <field name="ai_model"/>
            </group>
            <p>You may leave the API key empty and configure the provider manually later.</p>
          </div>

          <div invisible="step != 'admin'">
            <h2>4. Authorize the first Telegram administrator</h2>
            <p>Enter the permanent numeric Telegram ID. The display name or @username is not used for authentication.</p>
            <group>
              <field name="telegram_user_id"/>
              <field name="telegram_display_name"/>
              <field name="odoo_user_id"/>
            </group>
            <group string="Business permissions">
              <field name="permission_contacts"/>
              <field name="permission_crm"/>
              <field name="permission_sales_read"/>
              <field name="permission_invoices_read"/>
              <field name="permission_invoices_create"/>
            </group>
            <button name="action_finish" type="object" string="Install and activate the bot" class="btn-primary"/>
          </div>

          <div invisible="step != 'done'">
            <h2>Your Telegram assistant is ready</h2>
            <group>
              <field name="connection_id"/>
              <field name="bot_username"/>
              <field name="webhook_url" widget="url"/>
              <field name="result_message"/>
            </group>
            <button name="action_open_bot" type="object" string="Open the bot in Telegram" class="btn-primary"/>
            <button name="action_open_dashboard" type="object" string="Open dashboard" class="btn-secondary"/>
          </div>
        </sheet>
        <footer>
          <button name="action_back" type="object" string="Back" invisible="step in ('welcome', 'done')"/>
          <button name="action_next" type="object" string="Continue" class="btn-primary" invisible="step in ('token', 'admin', 'done')"/>
          <button string="Close" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_open_telegram_onboarding" model="ir.actions.server">
    <field name="name">Configure a Telegram Bot</field>
    <field name="model_id" ref="model_rb_telegram_onboarding_wizard"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_wizard()</field>
  </record>

  <record id="rb_messaging_automation_core.menu_messaging_root" model="ir.ui.menu">
    <field name="name">Telegram AI Hub</field>
  </record>
  <menuitem id="menu_telegram_dashboard"
            name="Dashboard"
            parent="rb_messaging_automation_core.menu_messaging_root"
            action="action_telegram_dashboard_client"
            sequence="1"/>
  <menuitem id="menu_telegram_onboarding"
            name="Setup Assistant"
            parent="rb_messaging_automation_core.menu_configuration"
            action="action_open_telegram_onboarding"
            sequence="1"/>
</odoo>
