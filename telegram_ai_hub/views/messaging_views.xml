<odoo>
  <record id="view_conversation_kanban" model="ir.ui.view">
    <field name="name">rb.messaging.conversation.kanban</field>
    <field name="model">rb.messaging.conversation</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state">
        <field name="name"/><field name="state"/><field name="partner_id"/><field name="last_message_at"/>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click o_kanban_record">
              <strong><field name="name"/></strong>
              <div><field name="partner_id"/></div>
              <div><field name="last_message_at"/></div>
            </div>
          </t>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click o_kanban_record">
              <strong><field name="name"/></strong>
              <div><field name="partner_id"/></div>
              <div><field name="last_message_at"/></div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <record id="view_conversation_form" model="ir.ui.view">
    <field name="name">rb.messaging.conversation.form</field><field name="model">rb.messaging.conversation</field>
    <field name="arch" type="xml"><form><header>
      <button name="action_transfer_human" type="object" string="Transfer to human"/>
      <button name="action_resume_bot" type="object" string="Resume bot"/>
      <button name="action_close" type="object" string="Close"/>
      <field name="state" widget="statusbar"/>
    </header><sheet><group><field name="name"/><field name="connection_id"/><field name="identity_id"/>
      <field name="partner_id"/><field name="operator_id"/><field name="bot_active"/></group>
      <notebook>
        <page string="Messages">
          <field name="message_ids" readonly="1">
            <tree create="0" edit="0" delete="0" default_order="create_date desc">
              <field name="create_date" string="Date"/>
              <field name="direction" widget="badge"/>
              <field name="message_type"/>
              <field name="body" string="Message"/>
              <field name="status" widget="badge"/>
              <field name="error_message"/>
              <field name="external_id"/>
            </tree>
          </field>
        </page>
      </notebook>
    </sheet><chatter/></form></field>
  </record>
  <record id="view_message_list" model="ir.ui.view">
    <field name="name">rb.messaging.message.list</field>
    <field name="model">rb.messaging.message</field>
    <field name="arch" type="xml">
      <tree create="0" edit="0" delete="0" default_order="create_date desc">
        <field name="create_date" string="Date"/>
        <field name="conversation_id"/>
        <field name="direction" widget="badge"/>
        <field name="message_type"/>
        <field name="body" string="Message"/>
        <field name="status" widget="badge"/>
        <field name="error_message"/>
        <field name="external_id"/>
      </tree>
    </field>
  </record>
  <record id="view_message_form" model="ir.ui.view">
    <field name="name">rb.messaging.message.form</field>
    <field name="model">rb.messaging.message</field>
    <field name="arch" type="xml">
      <form create="0" edit="0" delete="0">
        <sheet>
          <group>
            <group>
              <field name="conversation_id"/>
              <field name="connection_id"/>
              <field name="direction"/>
              <field name="message_type"/>
            </group>
            <group>
              <field name="create_date"/>
              <field name="status"/>
              <field name="external_id"/>
              <field name="company_id"/>
            </group>
          </group>
          <group string="Message content"><field name="body" nolabel="1"/></group>
          <group string="Error" attrs="{'invisible': [('error_message', '=', False)]}"><field name="error_message" nolabel="1"/></group>
          <group string="Technical payload" groups="telegram_ai_hub.group_messaging_technical">
            <field name="payload_json" nolabel="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_connection_list" model="ir.ui.view">
    <field name="name">rb.messaging.connection.list</field>
    <field name="model">rb.messaging.connection</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="channel_id"/>
        <field name="company_id"/>
        <field name="technical_user_id"/>
        <field name="language"/>
        <field name="active" widget="boolean_toggle"/>
      </tree>
    </field>
  </record>
  <record id="view_connection_form" model="ir.ui.view">
    <field name="name">rb.messaging.connection.form</field><field name="model">rb.messaging.connection</field>
    <field name="arch" type="xml"><form><sheet><group>
      <field name="name"/><field name="channel_id"/><field name="company_id"/><field name="technical_user_id"/>
      <field name="language"/><field name="active"/><field name="webhook_url" readonly="1"/>
    </group></sheet><chatter/></form></field>
  </record>
  <record id="view_workflow_form" model="ir.ui.view">
    <field name="name">rb.messaging.workflow.form</field><field name="model">rb.messaging.workflow</field>
    <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="active"/><field name="sequence"/>
      <field name="trigger_type"/><field name="trigger_value"/><field name="channel_ids" widget="many2many_tags"/>
      <field name="company_id"/></group><field name="step_ids"/></sheet></form></field>
  </record>
  <record id="view_workflow_list" model="ir.ui.view">
    <field name="name">rb.messaging.workflow.list</field>
    <field name="model">rb.messaging.workflow</field>
    <field name="arch" type="xml">
      <tree default_order="sequence">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="trigger_type"/>
        <field name="trigger_value"/>
        <field name="channel_ids" widget="many2many_tags"/>
        <field name="company_id"/>
        <field name="active" widget="boolean_toggle"/>
      </tree>
    </field>
  </record>
  <record id="view_audit_list" model="ir.ui.view">
    <field name="name">rb.messaging.audit.list</field>
    <field name="model">rb.messaging.audit</field>
    <field name="arch" type="xml">
      <tree create="0" edit="0" delete="0" default_order="create_date desc">
        <field name="create_date"/>
        <field name="conversation_id"/>
        <field name="workflow_id"/>
        <field name="step_id"/>
        <field name="user_id"/>
        <field name="result" widget="badge"/>
        <field name="duration_ms"/>
        <field name="error_message"/>
      </tree>
    </field>
  </record>
  <record id="view_audit_form" model="ir.ui.view">
    <field name="name">rb.messaging.audit.form</field>
    <field name="model">rb.messaging.audit</field>
    <field name="arch" type="xml">
      <form create="0" edit="0" delete="0">
        <sheet>
          <group>
            <group><field name="create_date"/><field name="result"/><field name="duration_ms"/></group>
            <group><field name="conversation_id"/><field name="workflow_id"/><field name="step_id"/><field name="user_id"/></group>
          </group>
          <group string="Error details" attrs="{'invisible': [('error_message', '=', False)]}"><field name="error_message" nolabel="1"/></group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_conversations" model="ir.actions.act_window">
    <field name="name">Conversations</field><field name="res_model">rb.messaging.conversation</field><field name="view_mode">kanban,form</field>
  </record>
  <record id="action_connections" model="ir.actions.act_window">
    <field name="name">Connections</field><field name="res_model">rb.messaging.connection</field><field name="view_mode">list,form</field>
  </record>
  <record id="action_workflows" model="ir.actions.act_window">
    <field name="name">Automations</field>
    <field name="res_model">rb.messaging.workflow</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'active_test': False}</field>
  </record>
  <record id="action_audits" model="ir.actions.act_window">
    <field name="name">Audit Logs</field><field name="res_model">rb.messaging.audit</field><field name="view_mode">list,form</field>
  </record>
  <record id="action_messages" model="ir.actions.act_window">
    <field name="name">Message History</field>
    <field name="res_model">rb.messaging.message</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False}</field>
  </record>
  <menuitem id="menu_messaging_root" name="Messaging" sequence="30" groups="group_messaging_reader"/>
  <menuitem id="menu_conversations" parent="menu_messaging_root" action="action_conversations" sequence="10"/>
  <menuitem id="menu_automation" name="Automations" parent="menu_messaging_root" sequence="20" groups="group_messaging_designer"/>
  <menuitem id="menu_workflows" parent="menu_automation" action="action_workflows"/>
  <menuitem id="menu_supervision" name="Supervision" parent="menu_messaging_root" sequence="30"/>
  <menuitem id="menu_messages" name="Message History" parent="menu_supervision" action="action_messages" sequence="5"/>
  <menuitem id="menu_audits" parent="menu_supervision" action="action_audits"/>
  <menuitem id="menu_configuration" name="Configuration" parent="menu_messaging_root" sequence="40" groups="group_messaging_technical"/>
  <menuitem id="menu_connections" parent="menu_configuration" action="action_connections"/>
</odoo>
