<odoo>
  <record id="view_ai_provider_form" model="ir.ui.view">
    <field name="name">rb.messaging.ai.provider.form</field>
    <field name="model">rb.messaging.ai.provider</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_test_connection" type="object" string="Test connection"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="active"/>
              <field name="provider_type"/>
              <field name="company_id"/>
              <field name="technical_user_id"/>
            </group>
            <group>
              <field name="base_url"/>
              <field name="api_key" password="True"/>
      <field name="model"/>
      <field name="transcription_model"/>
              <field name="timeout"/>
              <field name="max_tool_rounds"/>
            </group>
          </group>
          <group string="Connection status">
            <field name="last_test_at"/>
            <field name="last_test_status"/>
            <field name="last_test_message"/>
          </group>
          <group string="System instructions">
            <field name="system_instructions" nolabel="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="view_ai_provider_list" model="ir.ui.view">
    <field name="name">rb.messaging.ai.provider.list</field>
    <field name="model">rb.messaging.ai.provider</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/><field name="provider_type"/><field name="model"/>
        <field name="company_id"/><field name="active"/><field name="last_test_status"/>
      </list>
    </field>
  </record>
  <record id="action_ai_providers" model="ir.actions.act_window">
    <field name="name">AI Providers</field>
    <field name="res_model">rb.messaging.ai.provider</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_ai_providers"
            name="AI Providers"
            parent="telegram_ai_hub.menu_configuration"
            action="action_ai_providers"
            groups="telegram_ai_hub.group_messaging_technical"
            sequence="30"/>
</odoo>
